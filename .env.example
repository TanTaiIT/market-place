# Base URL của backend (repo `docs/Vue`), gồm cả prefix /api/v1.
#
# Mặc định dùng bản đã deploy — chạy được ngay trên thiết bị thật, không cần bật server local:
EXPO_PUBLIC_API_URL=https://market-ji5b.onrender.com/api/v1

# Muốn chạy với server local thì chọn theo nơi app chạy. `localhost` trên thiết bị thật là
# chính thiết bị đó, không phải máy dev, nên sẽ không kết nối được:
#   iOS simulator      http://localhost:5000/api/v1
#   Android emulator   http://10.0.2.2:5000/api/v1
#   Thiết bị thật      http://<IP-LAN-máy-dev>:5000/api/v1
#
# Socket.IO tự suy ra từ biến này bằng cách cắt phần `/api/v1` (xem src/api/socket.ts),
# nên không có biến riêng cho realtime.
#
# Expo inline biến EXPO_PUBLIC_* lúc bundle -> đổi giá trị phải chạy lại `npx expo start -c`.
