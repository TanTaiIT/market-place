{
  "expo": {
    "name": "Ghim",
    "slug": "ghim",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ghim",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ghim.app"
    },
    "android": {
      "package": "com.ghim.app",
      "adaptiveIcon": {
        "backgroundColor": "#B98851"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ghim cần truy cập thư viện ảnh để bạn chọn ảnh cho tin đăng.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#11170F"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
