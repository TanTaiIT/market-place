# Base URL của backend `market` (repo docs/market), gồm cả prefix /api/v1.
#
# Chọn giá trị theo nơi app chạy — `localhost` trên thiết bị thật là chính thiết bị đó,
# không phải máy dev, nên sẽ không kết nối được:
#   iOS simulator      http://localhost:5000/api/v1
#   Android emulator   http://10.0.2.2:5000/api/v1
#   Thiết bị thật      http://<IP-LAN-máy-dev>:5000/api/v1
#
# Expo inline biến EXPO_PUBLIC_* lúc bundle -> đổi giá trị phải chạy lại `npx expo start -c`.
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
